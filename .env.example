# Copy this file to .env and fill in real values. .env is gitignored —
# never commit keys.

# --- Gemini (listings + chat translation) ---------------------------------
# Free key from https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# --- Firebase (shared data across devices) --------------------------------
# console.firebase.google.com -> create a project -> add a Web app -> copy
# the config object. Leave these blank and the app stores everything on the
# device instead: it still works, you just cannot see anyone else's products.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
